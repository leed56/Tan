# ── Soma AI — Environment Variables ────────────────────────────────────────────
# Copy to .env.development / .env.staging / .env.production and fill in values.
# NEVER commit real keys to git.

# ── App environment ────────────────────────────────────────────────────────────
APP_ENV=development   # development | staging | production

# ── Firebase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Demo Mode (dev only — disable for production) ─────────────────────────────
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_OTP=123456

# ── Gemini AI (dev only — production uses Cloud Function proxy) ─────────────────
EXPO_PUBLIC_GEMINI_API_KEY=

# ── Firebase Cloud Functions base URL ─────────────────────────────────────────
EXPO_PUBLIC_FUNCTIONS_BASE_URL=http://localhost:5001/your_project_id/us-central1

# ── Selcom PayBox (server-side secrets — set in Cloud Functions, NOT here) ──────
# The Selcom API key/secret sign the checkout request and must never ship in the
# client bundle. The `initiateSelcomPayment` Cloud Function holds them.
# SELCOM_API_KEY, SELCOM_API_SECRET, SELCOM_VENDOR_ID, SELCOM_BASE_URL
# Run: firebase functions:secrets:set SELCOM_API_KEY etc.

# ── Azampay (server-side secrets — set in Cloud Functions environment, NOT here) ─
# AZAMPAY_APP_NAME, AZAMPAY_CLIENT_ID, AZAMPAY_CLIENT_SECRET
# Run: firebase functions:secrets:set AZAMPAY_APP_NAME etc.

# ── RevenueCat (publishable client SDK keys — safe to embed) ────────────────────
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# ── Firebase App Check ─────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=   # from Firebase Console → App Check

# ── Sentry ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# ── EAS ────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_EAS_PROJECT_ID=
