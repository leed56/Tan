    "summary": [
      {
        "questionText": "First law of indices (multiplication).",
        "options": [],
        "correctAnswer": "a^m x a^n = a^(m+n)",
        "explanation": "Powers with the same base are multiplied by adding the exponents.",
        "difficulty": "easy"
      },
      {
        "questionText": "Second law of indices (division).",
        "options": [],
        "correctAnswer": "a^m / a^n = a^(m-n)",
        "explanation": "Powers with the same base are divided by subtracting the exponents.",
        "difficulty": "easy"
      },
      {
        "questionText": "Power of a power law.",
        "options": [],
        "correctAnswer": "(a^m)^n = a^(mn)",
        "explanation": "Raising a power to another power multiplies the exponents.",
        "difficulty": "easy"
      },
      {
        "questionText": "Zero index rule.",
        "options": [],
        "correctAnswer": "a^0 = 1 (a not equal to 0)",
        "explanation": "Any non-zero base raised to power zero equals one.",
        "difficulty": "easy"
      },
      {
        "questionText": "Negative index rule.",
        "options": [],
        "correctAnswer": "a^(-n) = 1/a^n",
        "explanation": "A negative exponent equals the reciprocal of the positive power.",
        "difficulty": "easy"
      },
      {
        "questionText": "Fractional index meaning.",
        "options": [],
        "correctAnswer": "a^(m/n) = n-th root of (a^m)",
        "explanation": "The denominator gives the root and the numerator gives the power.",
        "difficulty": "easy"
      },
      {
        "questionText": "What is a surd?",
        "options": [],
        "correctAnswer": "An irrational root that cannot be simplified to a rational number",
        "explanation": "For example sqrt(2) and sqrt(3) are surds because their values are non-terminating, non-repeating decimals.",
        "difficulty": "easy"
      },
      {
        "questionText": "Multiplication rule for surds.",
        "options": [],
        "correctAnswer": "sqrt(a) x sqrt(b) = sqrt(ab)",
        "explanation": "The product of two square roots is the square root of the product.",
        "difficulty": "easy"
      },
      {
        "questionText": "How to rationalize a denominator of the form 1/sqrt(a).",
        "options": [],
        "correctAnswer": "Multiply numerator and denominator by sqrt(a)",
        "explanation": "This removes the surd from the denominator, giving sqrt(a)/a.",
        "difficulty": "easy"
      },
      {
        "questionText": "How to rationalize a denominator containing two terms like 1/(a + sqrt(b)).",
        "options": [],
        "correctAnswer": "Multiply by the conjugate (a - sqrt(b))",
        "explanation": "Using the conjugate applies the difference of two squares to clear the surd.",
        "difficulty": "easy"
      }
    ],
