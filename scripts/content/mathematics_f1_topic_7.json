    "summary": [
      {
        "questionText": "What is an equation?",
        "options": [],
        "correctAnswer": "An equation is a statement that two expressions are equal, joined by an equals sign.",
        "explanation": "For example, 2x + 3 = 11 says the left side equals the right side; solving it finds the unknown.",
        "difficulty": "easy"
      },
      {
        "questionText": "Balancing rule for equations",
        "options": [],
        "correctAnswer": "Do the same operation to both sides to keep the equation balanced.",
        "explanation": "Adding, subtracting, multiplying or dividing must be applied to both sides equally.",
        "difficulty": "easy"
      },
      {
        "questionText": "Solving a one-step equation",
        "options": [],
        "correctAnswer": "Undo the single operation using its inverse.",
        "explanation": "For x + 7 = 12, subtract 7 to get x = 5; for 3x = 12, divide by 3 to get x = 4.",
        "difficulty": "easy"
      },
      {
        "questionText": "Solving a two-step equation",
        "options": [],
        "correctAnswer": "First undo addition or subtraction, then undo multiplication or division.",
        "explanation": "For 2x + 3 = 11, subtract 3 to get 2x = 8, then divide by 2 to get x = 4.",
        "difficulty": "easy"
      },
      {
        "questionText": "Variable on both sides",
        "options": [],
        "correctAnswer": "Collect the variable terms on one side and the numbers on the other.",
        "explanation": "For 4x + 1 = 2x + 9, subtract 2x to get 2x + 1 = 9, then solve to get x = 4.",
        "difficulty": "easy"
      },
      {
        "questionText": "Equations with brackets",
        "options": [],
        "correctAnswer": "Expand the brackets first, then solve as usual.",
        "explanation": "For 2(x + 3) = 16, expand to 2x + 6 = 16, then x = 5.",
        "difficulty": "easy"
      },
      {
        "questionText": "Equations with fractions",
        "options": [],
        "correctAnswer": "Multiply through by the denominator to clear the fraction.",
