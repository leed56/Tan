{
  "name": "soma-ai",
  "version": "1.0.0",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:dev": "APP_ENV=development expo start",
    "start:staging": "APP_ENV=staging expo start",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:ios:prod": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "functions:build": "cd functions && npm run build",
    "functions:deploy": "cd functions && npm run deploy",
    "assets:generate": "node scripts/generate-assets.js",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:hosting": "cd admin && npm run build && cd .. && firebase deploy --only hosting"
  },
  "optionalDependencies": {
    "@react-native-community/netinfo": "^11.3.2",
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/app-check": "^21.0.0",
    "@react-native-firebase/auth": "^21.0.0",
    "@react-native-firebase/crashlytics": "^21.0.0",
    "@sentry/react-native": "^5.28.0",
    "@shopify/flash-list": "^1.7.1",
    "expo-build-properties": "~0.12.4",
    "react-native-purchases": "^8.2.5"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "expo": "~51.0.28",
    "expo-blur": "~13.0.2",
    "expo-font": "~12.0.9",
    "expo-linear-gradient": "~13.0.2",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "firebase": "^10.12.3",
    "moti": "^0.29.0",
    "nativewind": "^4.0.36",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "^0.19.13",
    "tailwindcss": "^3.4.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "@types/react-native": "~0.73.0",
    "typescript": "^5.1.3"
  },
  "private": true
}
